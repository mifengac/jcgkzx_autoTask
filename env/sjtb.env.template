# sjtb.env 可直接填写版模板
# 用法：
# 1. 复制本文件到目标机：/opt/sjtb/env/sjtb.env
# 2. 按实际环境填写下面的值
# 3. 运行时通过 --env-file /opt/sjtb/env/sjtb.env 注入
#
# 当前模板覆盖：
# - monitor_wcnr_jq.py
# - 0306jsbrjq_monitor.py
# - 0123_dxpt_ceshi.py
# - data_scraper_multi.py
# - zq_kshddpt_dsjfx_jq.py

# =========================
# 通用基础配置
# =========================

# 警情系统通用登录账号
LOGIN_USERNAME=your_login_username

# 警情系统通用登录密码
LOGIN_PASSWORD=your_login_password

# Oracle 连接串
# 常见格式：10.45.100.147:1521/yfgxpt
ORACLE_DSN=10.45.100.147:1521/yfgxpt

# Oracle 用户名
ORACLE_USER=your_oracle_user

# Oracle 密码
ORACLE_PASSWORD=your_oracle_password

# Oracle Instant Client 路径
# 留空表示使用 thin 模式；如需 thick 模式再填写
ORACLE_CLIENT_LIB_DIR=

# 短信网关账号
SMS_USERID=your_sms_userid

# 短信网关密码
SMS_PASSWORD=your_sms_password

# 短信网关端口
SMS_USERPORT=your_sms_userport

# 时区
TZ=Asia/Shanghai

# =========================
# 号码来源配置
# =========================

# 优先使用 Kingbase 联系人表取号
KINGBASE_HOST=10.45.100.148
KINGBASE_PORT=54321
KINGBASE_DBNAME=your_kingbase_db
KINGBASE_USER=your_kingbase_user
KINGBASE_PASSWORD=your_kingbase_password

# 默认联系人筛选 xqdm
# monitor 和 jsbrjq 都会用到
KG_TARGET_XQDM=445300

# 兜底手机号，多个用逗号分隔
# 只有在 Kingbase 不可用时才会回退使用
SMS_MOBILES=13800138000,13900139000

# =========================
# monitor_wcnr_jq.py
# =========================

# monitor 登录地址
MONITOR_LOGIN_URL=http://68.253.2.111/dsjfx/login

# monitor 查询地址
MONITOR_API_URL=http://68.253.2.111/dsjfx/case/list

# 是否启用第二次查询
# 1=启用，0=关闭
MONITOR_SECOND_QUERY_ENABLED=1

# 第二次查询使用的 newOriCharaSubclassNo
# 留空则走代码内默认值
MONITOR_SECOND_QUERY_NEWORI_SUBCLASS_NO=

# 第二次查询使用的 caseMarkNo
# 留空表示不额外限制
MONITOR_SECOND_QUERY_CASE_MARK_NO=

# =========================
# 0306jsbrjq_monitor.py
# =========================

# 如不单独填写，会自动回退到：
# JSBRJQ_LOGIN_URL -> MONITOR_LOGIN_URL
# JSBRJQ_API_URL -> MONITOR_API_URL
# JSBRJQ_LOGIN_USERNAME -> LOGIN_USERNAME
# JSBRJQ_LOGIN_PASSWORD -> LOGIN_PASSWORD

JSBRJQ_LOGIN_URL=http://68.253.2.111/dsjfx/login
JSBRJQ_API_URL=http://68.253.2.111/dsjfx/case/list
JSBRJQ_LOGIN_USERNAME=
JSBRJQ_LOGIN_PASSWORD=

# 单页查询条数
# 当前默认建议值：500
JSBRJQ_PAGE_SIZE=500

# Kingbase 联系人筛选 rwzt
# 通常保持默认即可
JSBRJQ_KG_TARGET_RWZT=涉精神病人

# =========================
# 0123_dxpt_ceshi.py
# =========================

# 查询起始日期，格式 YYYY-MM-DD
DXPT_START_DATE=2026-01-01

# 日志级别：DEBUG / INFO / WARNING / ERROR
DXPT_LOG_LEVEL=INFO

# 限制单次处理条数；留空表示不限制
DXPT_LIMIT=

# 是否演练模式
# 1=只演练不发短信，0=正常发送
DXPT_DRY_RUN=0

# 去重窗口（小时）
DEDUP_HOURS=12

# =========================
# zq_kshddpt_dsjfx_jq.py
# =========================

# 不填时，通常回退到通用或 monitor 配置；如需单独配置则填写
ZQ_LOGIN_URL=http://68.253.2.111/dsjfx/login
ZQ_API_URL=http://68.253.2.111/dsjfx/case/list
ZQ_LOGIN_USERNAME=
ZQ_LOGIN_PASSWORD=

# zq 数据库连接；留空时通常回退到通用 KINGBASE_* 配置
ZQ_DB_HOST=
ZQ_DB_PORT=
ZQ_DB_NAME=
ZQ_DB_USER=
ZQ_DB_PASSWORD=

# zq 业务参数
ZQ_DB_SCHEMA=ywdata
ZQ_BEGIN_DAYS_AGO=3
ZQ_PAGE_SIZE=99999
ZQ_PAGE_NUM=1

# =========================
# data_scraper_multi.py
# =========================

# 是否启用 multi 任务
# 1=启用，0=关闭
DATA_MULTI_TASK_ENABLED=1

# multi 登录与接口
MULTI_LOGIN_URL=http://68.253.2.111/dsjfx/login
MULTI_LOGIN_USERNAME=
MULTI_LOGIN_PASSWORD=
MULTI_API_URL_DUTY=

# multi 数据库连接
MULTI_DB_HOST=
MULTI_DB_PORT=
MULTI_DB_NAME=
MULTI_DB_USER=
MULTI_DB_PASSWORD=
MULTI_DB_SSLMODE=disable

# multi 运行参数
MULTI_MODE=append
MULTI_MAX_WORKERS=31
MULTI_REQUEST_TIMEOUT=180
MULTI_BEGIN_DAYS_AGO=9
MULTI_END_DAYS_AGO=0
