# =========================
# Common
# =========================
# 登录账号（通用，zq/multi 未单独配置时会回退使用）
LOGIN_USERNAME=
# 登录密码（通用，zq/multi 未单独配置时会回退使用）
LOGIN_PASSWORD=

# Oracle 连接串，格式示例：10.45.100.147:1521/yfgxpt
ORACLE_DSN=
# Oracle 用户名
ORACLE_USER=
# Oracle 密码
ORACLE_PASSWORD=
# Oracle Instant Client 路径（可留空，留空则使用 thin 模式）
ORACLE_CLIENT_LIB_DIR=

# 短信网关账号（monitor / 0123 下发短信必填）
SMS_USERID=
# 短信网关密码（monitor / 0123 下发短信必填）
SMS_PASSWORD=
# 短信网关端口（monitor / 0123 下发短信必填）
SMS_USERPORT=

# Kingbase 主机
KINGBASE_HOST=
# Kingbase 端口
KINGBASE_PORT=
# Kingbase 数据库名
KINGBASE_DBNAME=
# Kingbase 用户名
KINGBASE_USER=
# Kingbase 密码
KINGBASE_PASSWORD=
# monitor 联系人筛选 xqdm（默认 445300）
KG_TARGET_XQDM=445300

# 手机号列表（逗号分隔）
# - monitor: 仅在 Kingbase 不可用时作为兜底
# - 0123: 作为基础发送目标，可留空（留空时仅使用派出所联系人）
SMS_MOBILES=
# 去重窗口（小时）
DEDUP_HOURS=12
# 时区（建议固定 Asia/Shanghai）
TZ=Asia/Shanghai

# =========================
# monitor_wcnr_jq.py
# =========================
# monitor 登录 URL
MONITOR_LOGIN_URL=http://68.253.2.111/dsjfx/login
# monitor 数据查询 URL
MONITOR_API_URL=http://68.253.2.111/dsjfx/case/list

# =========================
# zq_kshddpt_dsjfx_jq.py
# =========================
# zq 登录 URL（不填可回退 MONITOR_LOGIN_URL）
ZQ_LOGIN_URL=http://68.253.2.111/dsjfx/login
# zq 数据查询 URL（不填可回退 MONITOR_API_URL）
ZQ_API_URL=http://68.253.2.111/dsjfx/case/list
# zq 登录用户名（不填可回退 LOGIN_USERNAME）
ZQ_LOGIN_USERNAME=
# zq 登录密码（不填可回退 LOGIN_PASSWORD）
ZQ_LOGIN_PASSWORD=
# zq 数据库主机（不填可回退 KINGBASE_HOST）
ZQ_DB_HOST=
# zq 数据库端口（不填可回退 KINGBASE_PORT）
ZQ_DB_PORT=
# zq 数据库名（不填可回退 KINGBASE_DBNAME）
ZQ_DB_NAME=
# zq 数据库用户（不填可回退 KINGBASE_USER）
ZQ_DB_USER=
# zq 数据库密码（不填可回退 KINGBASE_PASSWORD）
ZQ_DB_PASSWORD=
# zq 写入 schema
ZQ_DB_SCHEMA=ywdata
# zq 查询起始天数（N 天前 00:00:00）
ZQ_BEGIN_DAYS_AGO=3
# zq 每页条数
ZQ_PAGE_SIZE=99999
# zq 页码
ZQ_PAGE_NUM=1

# =========================
# data_scraper_multi.py
# =========================
# 是否启用 multi 任务（1 启用，0 关闭）
DATA_MULTI_TASK_ENABLED=1
# multi 登录 URL（必填）
MULTI_LOGIN_URL=
# multi 登录用户名（不填可回退 LOGIN_USERNAME）
MULTI_LOGIN_USERNAME=
# multi 登录密码（不填可回退 LOGIN_PASSWORD）
MULTI_LOGIN_PASSWORD=
# multi 勤务接口 URL（可按需覆盖代码默认）
MULTI_API_URL_DUTY=
# multi 数据库主机（不填可回退 KINGBASE_HOST）
MULTI_DB_HOST=
# multi 数据库端口（不填可回退 KINGBASE_PORT）
MULTI_DB_PORT=
# multi 数据库名（不填可回退 KINGBASE_DBNAME）
MULTI_DB_NAME=
# multi 数据库用户（不填可回退 KINGBASE_USER）
MULTI_DB_USER=
# multi 数据库密码（不填可回退 KINGBASE_PASSWORD）
MULTI_DB_PASSWORD=
# multi 数据库 SSL 模式（常用 disable）
MULTI_DB_SSLMODE=disable
# 入库模式：append / replace
MULTI_MODE=append
# 并发线程数
MULTI_MAX_WORKERS=31
# 单请求超时时间（秒）
MULTI_REQUEST_TIMEOUT=180
# 查询起始天数（N 天前）
MULTI_BEGIN_DAYS_AGO=9
# 查询结束天数（通常为 0 表示今天）
MULTI_END_DAYS_AGO=0

# =========================
# 0123_dxpt_ceshi.py
# =========================
# 0123 脚本查询起始日期（必填，格式 YYYY-MM-DD）
DXPT_START_DATE=
# 0123 日志级别：DEBUG/INFO/WARNING/ERROR
DXPT_LOG_LEVEL=INFO
# 0123 单次处理上限（可空；空表示不限）
DXPT_LIMIT=
# 0123 是否演练模式（1=只演练不发送，0=正常发送）
DXPT_DRY_RUN=0
