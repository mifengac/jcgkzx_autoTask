# =========================
# Common
# =========================
# 通用登录账号；jsbrjq 未单独配置时会回退使用
LOGIN_USERNAME=
LOGIN_PASSWORD=

# Oracle 连接，例如 10.45.100.147:1521/yfgxpt
ORACLE_DSN=
ORACLE_USER=
ORACLE_PASSWORD=
# 留空则使用 thin 模式
ORACLE_CLIENT_LIB_DIR=

# 短信网关（monitor / jsbrjq / 0123 需要）
SMS_USERID=
SMS_PASSWORD=
SMS_USERPORT=

# Kingbase
KINGBASE_HOST=
KINGBASE_PORT=
KINGBASE_DBNAME=
KINGBASE_USER=
KINGBASE_PASSWORD=

# 默认联系人筛选 xqdm
KG_TARGET_XQDM=445300

# 兜底手机号，逗号分隔
# 仅在 Kingbase 不可用时使用
SMS_MOBILES=

# 时区
TZ=Asia/Shanghai

# =========================
# monitor_wcnr_jq.py
# =========================
MONITOR_LOGIN_URL=http://68.253.2.111/dsjfx/login
MONITOR_API_URL=http://68.253.2.111/dsjfx/case/list
MONITOR_SECOND_QUERY_ENABLED=1
MONITOR_SECOND_QUERY_NEWORI_SUBCLASS_NO=
MONITOR_SECOND_QUERY_CASE_MARK_NO=

# =========================
# 0306jsbrjq_monitor.py
# =========================
# 不填可分别回退 MONITOR_LOGIN_URL / MONITOR_API_URL / LOGIN_USERNAME / LOGIN_PASSWORD
JSBRJQ_LOGIN_URL=http://68.253.2.111/dsjfx/login
JSBRJQ_API_URL=http://68.253.2.111/dsjfx/case/list
