# Docker image tag used by docker compose.
IMAGE_NAME=jcgkzx-autotask:latest

# Base Python image used when building the Docker image.
PYTHON_BASE_IMAGE=python:3.11-slim-bookworm

# Primary Python package index used by uv during image builds.
UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# Extra Python package index used by uv during image builds.
UV_EXTRA_INDEX_URL=https://pypi.org/simple

# Debian package mirror used during Docker image builds.
APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian

# Debian security package mirror used during Docker image builds.
APT_SECURITY_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security

# Display name for the FastAPI application.
APP_NAME=JCGKZX AutoTask API

# Runtime environment label. Use production for deployed instances.
APP_ENV=production

# Host interface the application binds to inside the container.
APP_HOST=0.0.0.0

# Host port exposed by docker compose.
APP_PORT=8000

# Default timezone for scheduling and time rendering.
TZ=Asia/Shanghai

# Cookie name used for browser sessions.
AUTH_COOKIE_NAME=autotask_session

# Secret key used to sign authentication sessions. Replace this in every deployment.
AUTH_SECRET_KEY=change-this-to-a-long-random-secret

# Browser session lifetime in hours.
AUTH_SESSION_TTL_HOURS=12

# Platform database SQLAlchemy URL. Required.
# KingbaseV8 can use a PostgreSQL-compatible URL such as:
# postgresql+psycopg2://user:password@10.45.100.148:54321/dbname
DATABASE_URL=

# Database schema name used for platform tables.
DB_SCHEMA=jcgkzx_autotask

# Set true to log SQLAlchemy SQL statements for debugging.
DB_ECHO=false

# Auto-create platform tables at startup. Use true only for first-time setup.
AUTO_CREATE_TABLES=false

# --- 短信发送（经内网 oracle-sms-gateway HTTP，宿主默认 5011）---
# 网关基址，不要尾斜杠。部署时容器内可写 http://host.docker.internal:5011。
SMS_GATEWAY_BASE_URL=http://127.0.0.1:5011

# 网关 API Key（对应网关侧 X-API-Key / Bearer token）。必填才能真实发送。
SMS_GATEWAY_TOKEN=

# 业务标识 biz，网关按 SMS_BIZ_USERPORTS 映射 userport；本项目默认 yfjcgkzx。
SMS_GATEWAY_BIZ=yfjcgkzx

# HTTP 超时秒数（连接与读取各用该值）。
SMS_GATEWAY_TIMEOUT_SECONDS=10

# 连接失败 / 超时 / 5xx 时的额外重试次数（默认 2，退避约 1s、3s；4xx 不重试）。
SMS_GATEWAY_MAX_RETRIES=2

# 自定义任务等原「永久去重」的近似窗口（小时），约 10 年；发送时 ×60 为分钟。
SMS_GATEWAY_PERMANENT_DEDUP_HOURS=87600

# --- 以下 SMS_* 已不再用于平台短信发送（凭证由网关 .env 管理）---
# 本轮保留以免旧 .env 加载失败；ORACLE_* 客户端配置已移除。

# 短信账号（废弃：由网关 SMS_USERID 管理）。
SMS_USERID=

# 短信密码（废弃：由网关 SMS_PASSWORD 管理）。
SMS_PASSWORD=

# 短信端口（废弃：由网关 SMS_BIZ_USERPORTS 按 biz 映射）。
SMS_USERPORT=

# 业务名→端口 JSON（废弃：改配网关 SMS_BIZ_USERPORTS）。
SMS_BUSINESS_PORTS_JSON={}

# Optional login username for HTTP theme sources when referenced by source_config.credential_ref.username_env.
LOGIN_USERNAME=

# Optional login password for HTTP theme sources when referenced by source_config.credential_ref.password_env.
LOGIN_PASSWORD=

# Optional database-backed theme source SQLAlchemy URL.
# kingbase_multi_sql uses THEME_DB_URL first, then falls back to DATABASE_URL.
THEME_DB_URL=
