# 如果是远端数据库，填实际 IP 或域名，例如 10.45.100.148
KINGBASE_HOST=
KINGBASE_PORT=54321
KINGBASE_DBNAME=
KINGBASE_USER=
KINGBASE_PASSWORD=
DB_SCHEMA=jcgkzx_autotask
DB_ECHO=false
# 首次启动且数据库中还没有表时，可临时设为 true，建表完成后改回 false
AUTO_CREATE_TABLES=false

